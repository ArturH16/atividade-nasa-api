<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nasa APOD</title>
    <style>
.carousel {
  width: 100%;
  max-width: 600px;
  margin: auto;
  overflow: hidden;
  position: relative;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.carousel-images {
  display: flex;
  transition: transform 0.5s ease-in-out;
}

.card {
  min-width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 10px;
}

.card img {
  width: 100%;
  height: auto;
  max-height: 500px;
  object-fit: cover;
  border-radius: 4px;
}

/* Botões */
.btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: rgba(0, 0, 0, 0.6);
  color: white;
  border: none;
  cursor: pointer;
  padding: 12px;
  font-size: 18px;
  border-radius: 50%;
  transition: 0.3s;
}

.btn:hover { background-color: rgba(0, 0, 0, 0.9); }
.prev { left: 15px; }
.next { right: 15px; }

</style>
</head>
<body>
    {{{body}}}

</body>
</html>