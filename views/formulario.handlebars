<h1>Seja bem vindo ao Pictures'Nasa</h1>
<form action="/form" method="post">
<label for="astro">Escolha um astro para ver imagens dos últimos 60 dias:</label>
<select name="astro" id="astro">
    <option value="">Selecione um astro</option>
    <option value="sun">Sol</option>
    <option value="mars">Marte</option>
    <option value="moon">Lua</option>
     <option value="milky way">Via Láctea</option>
    <option value="nebula">Nebulosas</option>
    <option value="clouds">Nuvens</option>
    <option value="eclipse">Eclipse</option>
    <option value="a"></option>
</select>
<button type="submit">Buscar imagem</button>
</form>